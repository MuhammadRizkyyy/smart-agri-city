{
  "name": "smart-agri-city-gateway",
  "version": "1.0.0",
  "description": "API Gateway for Smart Agri City Platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --no-deprecation ./node_modules/jest-cli/bin/jest.js --coverage --testPathPattern=__tests__",
    "test:ci": "node --no-deprecation ./node_modules/jest-cli/bin/jest.js --coverage --ci --testPathPattern=__tests__"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 60
      }
    },
    "coverageReporters": [
      "text",
      "lcov"
    ]
  },
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "http-proxy-middleware": "^2.0.6",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "node-mocks-http": "^1.14.1",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
