{
  "info": {
    "_postman_id": "s1-iot-ingestion",
    "name": "S1 - IoT Data Ingestion Pipeline",
    "description": "Skenario 1: Verifikasi alur data dari sensor IoT (MQTT) melewati Node-RED → Gateway → Database → RabbitMQ",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1.1 - Verifikasi IoT Simulator Berjalan",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["health"]
        },
        "description": "Cek apakah semua service (termasuk IoT simulator) sehat"
      }
    },
    {
      "name": "1.2 - Cek Health Mosquitto MQTT",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["health"]
        },
        "description": "Verifikasi Mosquitto MQTT Broker sehat"
      }
    },
    {
      "name": "1.3 - Get IoT Token (client_credentials)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  var jsonData = pm.response.json();",
              "  pm.environment.set('iot_token', jsonData.access_token);",
              "  console.log('✓ IoT Token saved to environment');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "client_id",
              "value": "iot-device"
            },
            {
              "key": "client_secret",
              "value": "iot_secret_456"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:3002/oauth/token",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3002",
          "path": ["oauth", "token"]
        },
        "description": "Dapatkan IoT token dengan grant_type client_credentials"
      }
    },
    {
      "name": "1.4 - POST Sensor Data ke Gateway",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{iot_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"zone_id\": 1,\n  \"moisture\": 42.5,\n  \"temperature\": 28.1,\n  \"ph\": 6.8,\n  \"nitrogen\": 75,\n  \"phosphorus\": 35,\n  \"potassium\": 55,\n  \"air_temp\": 28.1,\n  \"air_humidity\": 68.0,\n  \"light_lux\": 5000.0\n}"
        },
        "url": {
          "raw": "http://localhost:3000/iot/sensor",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["iot", "sensor"]
        },
        "description": "Kirim data sensor melalui Gateway (HTTP 200/201 diharapkan)"
      }
    },
    {
      "name": "1.5 - Verifikasi Data Tersimpan di Database",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Gunakan access_token dari S2.1 (farmer login) atau iot_token dari S1.3 (IoT device)",
              "var accessToken = pm.environment.get('access_token');",
              "var iotToken = pm.environment.get('iot_token');",
              "var token = accessToken || iotToken;",
              "",
              "if (!token) {",
              "  console.log('⚠️ No token available');",
              "  console.log('   Option 1: Run S1.3 (Get IoT Token) first');",
              "  console.log('   Option 2: Run S2.1 (Login Farmer) to get access_token');",
              "  throw new Error('Missing token');",
              "} else {",
              "  var tokenSource = accessToken ? 'access_token (S2.1 Farmer Login)' : 'iot_token (S1.3 IoT Device)';",
              "  console.log('✓ Using token from:', tokenSource);",
              "  pm.request.headers.add({key: 'Authorization', value: 'Bearer ' + token});",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  console.log('✓ Data sensor terbaru berhasil diambil dari database');",
              "  var jsonData = pm.response.json();",
              "  console.log('Total readings:', jsonData.data ? jsonData.data.length : 0);",
              "  if (jsonData.data && jsonData.data.length > 0) {",
              "    console.log('Latest zone reading:');",
              "    var latest = jsonData.data[0];",
              "    console.log('  Zone:', latest.zone_id);",
              "    console.log('  Moisture:', latest.moisture + '%');",
              "    console.log('  Temperature:', latest.temperature + '°C');",
              "    console.log('  Time:', latest.recorded_at);",
              "  }",
              "} else if (pm.response.code === 401) {",
              "  console.log('❌ Unauthorized - Token missing or invalid. Run S1.3 first.');",
              "} else {",
              "  console.log('❌ Error:', pm.response.code, pm.response.text());",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/sensors/latest",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "sensors", "latest"]
        },
        "description": "Verifikasi data sensor terbaru yang telah tersimpan di database - mengembalikan JSON response dengan sensor readings terbaru dari semua zona"
      }
    },
    {
      "name": "1.6 - Cek RabbitMQ Queue",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:15672",
          "protocol": "http",
          "host": ["localhost"],
          "port": "15672"
        },
        "description": "Buka RabbitMQ Management (http://localhost:15672), login: guest/guest, cek queue sensor.data"
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "oauth_url",
      "value": "http://localhost:3002"
    },
    {
      "key": "iot_token",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    }
  ]
}
