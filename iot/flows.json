    {
        "id": "f1_mqtt_sensor",
        "type": "mqtt in",
        "z": "tab_flow1",
        "name": "Subscribe agri/+/sensor",
        "topic": "agri/+/sensor",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_config",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 160,
        "y": 100,
        "wires": [["f1_save_sensor"]]
    },
    {
        "id": "f1_save_sensor",
        "type": "function",
        "z": "tab_flow1",
        "name": "Prepare payload & build token request",
        "func": "var data = msg.payload;\n\nvar zoneMapping = {\n    'zone-a': 1,\n    'zone-b': 2,\n    'zone-c': 3,\n    'zone-d': 4,\n    'zone-e': 5,\n    'zona1':  1,\n    'zona2':  2,\n    'zona3':  3,\n    'zona4':  4\n};\n\nvar zoneStr = (data.zone || '').toLowerCase();\nvar zoneId  = zoneMapping[zoneStr] || 1;\n\nmsg._sensorPayload = {\n    zone_id:      zoneId,\n    zone:         zoneId,\n    moisture:     data.moisture     || 50.0,\n    temperature:  data.temperature  || 28.0,\n    ph:           data.ph           || 6.5,\n    nitrogen:     data.nitrogen     || 70.0,\n    phosphorus:   data.phosphorus   || 45.0,\n    potassium:    data.potassium    || 80.0,\n    air_temp:     data.air_temp     || data.temperature || 28.0,\n    air_humidity: data.humidity     || data.air_humidity || 70.0,\n    light_lux:    data.light_lux    || 5000.0,\n    timestamp:    data.timestamp    || new Date().toISOString()\n};\n\nmsg.payload = 'grant_type=client_credentials&client_id=iot-device&client_secret=iot_secret_456';\nmsg.headers = {'Content-Type': 'application/x-www-form-urlencoded'};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 100,
        "wires": [["f1_get_token"]]
    },
    {
        "id": "f1_get_token",
        "type": "http request",
        "z": "tab_flow1",
        "name": "GET OAuth Token (client_credentials)",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "body",
        "url": "http://oauth-server:3002/oauth/token",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [
            {
                "keyType": "str",
                "keyValue": "Content-Type",
                "valueType": "str",
                "valueValue": "application/x-www-form-urlencoded"
            }
        ],
        "x": 670,
        "y": 100,
        "wires": [["f1_set_auth_header"]]
    },
    {
        "id": "f1_set_auth_header",
        "type": "function",
        "z": "tab_flow1",
        "name": "Set Authorization Header",
        "func": "var tokenResp = msg.payload;\nvar accessToken = tokenResp.access_token || '';\n\nif (!accessToken) {\n    node.error('Failed to get access token: ' + JSON.stringify(tokenResp));\n    return null;\n}\n\nmsg.headers = {\n    'Authorization': 'Bearer ' + accessToken,\n    'Content-Type':  'application/json'\n};\n\nmsg.payload = msg._sensorPayload;\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 930,
        "y": 100,
        "wires": [["f1_post_sensor"]]
    },
