    {
        "id": "f1b_mqtt_alert",
        "type": "mqtt in",
        "z": "tab_flow1",
        "name": "Subscribe agri/+/alert",
        "topic": "agri/+/alert",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_config",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
