# GLOBAL SYSTEM SETTINGS
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_change_me_in_production_123456789
TIMEZONE=Asia/Jakarta

# DATABASE CONFIGURATION (MySQL) 
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agriCity
DB_USERNAME=root
DB_PASSWORD=rootpass

# MESSAGE BROKER CONFIGURATION (RabbitMQ) 
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# IoT LAYER CONFIGURATION (MQTT Broker & Node-RED) 
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=admin
MQTT_PASSWORD=adminpass
MQTT_CLIENT_ID=agri_simulator_01

NODE_RED_PORT=1880

# MICROSERVICES PORT MAPPINGS & ENDPOINTS 
# API Gateway Endpoint (Main Entrypoint)
API_GATEWAY_URL=http://localhost:3000
API_GATEWAY_PORT=3000

# OAuth 2.0 Authorization Server
OAUTH_SERVER_URL=http://localhost:3002
OAUTH_SERVER_PORT=3002

# PHP Farmer MVC Service
FARMER_SERVICE_URL=http://localhost:8000
FARMER_SERVICE_PORT=8000

# PHP Crop MVC Service
CROP_SERVICE_URL=http://localhost:8001
CROP_SERVICE_PORT=8001

# PHP Irrigation MVC Service
IRRIGATION_SERVICE_URL=http://localhost:8002
IRRIGATION_SERVICE_PORT=8002

# Python FastAPI Machine Learning Service
PYTHON_ML_URL=http://localhost:5000
PYTHON_ML_PORT=5000

# MONITORING CONFIGURATIONS 
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
