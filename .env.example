NODE_ENV=development
TIMEZONE=Asia/Jakarta

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3002/oauth/google/callback

# URL frontend tujuan redirect setelah login Google berhasil
# Kosongkan untuk fallback response JSON (berguna saat testing)
FRONTEND_URL=

# client_id OAuth internal yang dipakai saat login via Google
GOOGLE_OAUTH_CLIENT_ID=web-client

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=agriCity
DB_USERNAME=agri_user
DB_PASSWORD=change_me_db_password

JWT_SECRET=change_me_jwt_secret_at_least_32_characters_long

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=change_me_rabbitmq_password

MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=admin
MQTT_PASSWORD=change_me_mqtt_password
MQTT_CLIENT_ID=agri_simulator_docker

API_GATEWAY_PORT=3000
GRAFANA_PORT=3001
OAUTH_SERVER_PORT=3002
FARMER_SERVICE_PORT=8000
CROP_SERVICE_PORT=8001
IRRIGATION_SERVICE_PORT=8002
PYTHON_ML_PORT=5000
NODE_RED_PORT=1880
PROMETHEUS_PORT=9090
PHPMYADMIN_PORT=8080

# Grafana admin credentials (default: admin/admin)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Rate Limiting Configuration (optional, defaults shown)
# Global rate limit: 1000 requests per 15 minutes
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=1000

# Auth rate limit: 1000 requests per 1 minute per IP/token
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=1000

# IoT rate limit: 10000 requests per 1 minute (for sensor data ingestion)
RATE_LIMIT_IOT_WINDOW_MS=60000
RATE_LIMIT_IOT_MAX=10000
