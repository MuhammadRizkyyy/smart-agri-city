        },
        "url": {
          "raw": "http://localhost:3000/public/petani/harvests",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["public", "petani", "harvests"]
        },
        "description": "Test dengan petani yang berbeda (farmer_id: 2)"
      }
    },
