    {
      "name": "🌾 Scenario 1: Public Endpoint (Petani Tanpa Login)",
      "item": [
        {
          "name": "GET Status Lahan (Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function() {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test('Response berisi nama petani', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.data.nama_petani).to.exist;",
                  "});",
                  "",
                  "pm.test('Response berisi kondisi lahan', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.data.kondisi_lahan).to.exist;",
                  "});",
                  "",
                  "pm.test('Tidak perlu token (public endpoint)', function() {",
                  "  pm.expect(pm.response.code).to.not.equal(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/public/petani/6281234567001/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "public",
                "petani",
                "6281234567001",
                "status"
              ]
            },
            "description": "Petani akses status lahan dengan nomor telepon (tanpa login)"
          }
        },
        {
          "name": "GET Alert Publik per Zone",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function() {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test('Response adalah array', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(Array.isArray(jsonData.data)).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/public/zones/1/alerts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "public",
                "zones",
                "1",
                "alerts"
              ]
            },
            "description": "Lihat alert aktif di zona tertentu (public endpoint)"
          }
        }
      ]
    },
    {
      "name": "👮 Scenario 2-3: Role RBAC — Petugas (Allowed)",
      "item": [
        {
          "name": "PATCH Resolve Alert (Petugas — Allowed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status tidak 403 (akses diterima)', function() {",
                  "  pm.expect(pm.response.code).to.not.equal(403);",
                  "});",
                  "",
                  "pm.test('Request dengan token petugas diterima', function() {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 404, 500]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_petugas}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\",\n  \"notes\": \"Sudah ditangani\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/alerts/1/resolve",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "alerts",
                "1",
                "resolve"
              ]
            },
            "description": "Petugas resolve alert - harus ALLOWED (200/404, bukan 403)"
          }
        }
      ]
    },
    {
      "name": "❌ Scenario 4: Role RBAC — Petani (Denied)",
      "item": [
        {
          "name": "PATCH Resolve Alert (Petani — Denied)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 Forbidden', function() {",
                  "  pm.expect(pm.response.code).to.equal(403);",
                  "});",
                  "",
                  "pm.test('Error message jelas', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.message).to.include('Akses ditolak');",
                  "});",
                  "",
                  "pm.test('Allowed roles ditampilkan', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.data.allowed_roles).to.include('petugas');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_petani}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/alerts/1/resolve",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "alerts",
                "1",
                "resolve"
              ]
            },
            "description": "Petani coba resolve alert - harus DENIED (403 Forbidden)"
          }
        },
        {
          "name": "POST Irigasi Manual (Petani — Denied)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 403 Forbidden', function() {",
                  "  pm.expect(pm.response.code).to.equal(403);",
                  "});",
                  "",
                  "pm.test('Role mismatch message', function() {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.message).to.include('Akses ditolak');",
                  "  pm.expect(jsonData.data.your_role).to.equal('petani');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_petani}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"zone_id\": 1,\n  \"action\": \"irrigate\",\n  \"duration_minutes\": 30\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/irrigation/command",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "irrigation",
                "command"
              ]
            },
            "description": "Petani coba kirim perintah irigasi - harus DENIED (403)"
          }
        }
      ]
