    {
        "id": "f2_fetch_valve_cmd",
        "type": "http request",
        "z": "tab_flow2",
        "name": "GET iot.valve from RabbitMQ HTTP API",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://rabbitmq:15672/api/queues/%2F/iot.valve/get",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "basic",
        "senderr": false,
        "credentials": {
            "user": "guest",
            "password": "guest"
        },
        "headers": [
            {
                "keyType": "str",
                "keyValue": "Content-Type",
                "valueType": "str",
                "valueValue": "application/json"
