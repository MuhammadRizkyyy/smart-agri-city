    {
        "id": "f2_parse_valve",
        "type": "function",
        "z": "tab_flow2",
        "name": "Parse valve command",
        "func": "var messages = msg.payload;\n\nif (!Array.isArray(messages) || messages.length === 0) {\n    return null;\n}\n\nvar item = messages[0];\nvar body = {};\ntry {\n    body = JSON.parse(item.payload || '{}');\n} catch (e) {\n    body = {};\n}\n\nvar zone   = body.zone   || body.zone_id || 'zone-a';\nvar action = body.action || 'open';\n\nmsg.topic   = 'agri/commands/valve/' + zone;\nmsg.payload = JSON.stringify({\n    action:    action,\n    zone:      zone,\n    log_id:    body.log_id   || 0,\n    urgency:   body.urgency  || 'NORMAL',\n    trigger:   body.trigger  || 'otomatis_ml',\n    timestamp: new Date().toISOString()\n});\n\nnode.status({fill:'blue', shape:'dot', text: 'Valve ' + action + ' @ ' + zone});\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 720,
        "y": 100,
        "wires": [["f2_mqtt_publish", "f2_debug_valve"]]
    },
