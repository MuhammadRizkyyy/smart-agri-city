    {
        "id": "f3_format_alert",
        "type": "function",
        "z": "tab_flow3",
        "name": "Format pest alert notification",
        "func": "var messages = msg.payload;\n\nif (!Array.isArray(messages) || messages.length === 0) {\n    return null;\n}\n\nvar results = [];\n\nfor (var i = 0; i < messages.length; i++) {\n    var item = messages[i];\n    var body = {};\n    try {\n        body = JSON.parse(item.payload || '{}');\n    } catch (e) {\n        body = {};\n    }\n\n    var threat   = body.threat_detected || 'Tidak diketahui';\n    var zone     = body.zone            || body.zone_id || '-';\n    var severity = body.severity        || 'WARNING';\n    var ts       = body.timestamp       || new Date().toISOString();\n\n    results.push({\n        title:     '🚨 Hama Terdeteksi: ' + threat,\n        zone:      zone,\n        severity:  severity,\n        message:   'Zona ' + zone + ' terdeteksi ' + threat + '. Tindakan segera diperlukan!',\n        timestamp: ts,\n        raw:       body\n    });\n}\n\nif (results.length === 0) return null;\n\nmsg.payload = results.length === 1 ? results[0] : results;\nmsg.topic   = 'pest_alert';\n\nnode.status({fill:'red', shape:'ring', text: results.length + ' alert(s) baru'});\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 760,
        "y": 100,
        "wires": [["f3_dashboard_text", "f3_debug_alert"]]
    },
