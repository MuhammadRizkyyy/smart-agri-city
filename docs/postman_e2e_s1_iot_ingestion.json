{
  "info": {
    "_postman_id": "s1-iot-ingestion",
    "name": "S1 - IoT Data Ingestion Pipeline",
    "description": "Skenario 1: Verifikasi alur data dari sensor IoT (MQTT) melewati Node-RED → Gateway → Database → RabbitMQ. TANPA LOGIN PETANI - IoT devices hanya perlu token IoT untuk mengirim data sensor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1.0 - Get IoT Token (REQUIRED FIRST!)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  var jsonData = pm.response.json();",
              "  pm.environment.set('iot_token', jsonData.access_token);",
              "  console.log('✓ IoT Token berhasil disimpan ke environment');",
              "  console.log('Token:', jsonData.access_token.substring(0, 20) + '...');",
              "} else {",
              "  console.log('❌ Gagal mendapatkan IoT token. Response:', pm.response.code);",
              "  throw new Error('Failed to get IoT token');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "client_id",
              "value": "iot-device"
            },
            {
              "key": "client_secret",
              "value": "iot_secret_456"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:3002/oauth/token",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3002",
          "path": ["oauth", "token"]
        },
        "description": "MANDATORY: Dapatkan IoT device token dengan grant_type client_credentials. HARUS dijalankan terlebih dahulu sebelum langkah lainnya."
      }
    },
    {
      "name": "1.1 - Verifikasi IoT Simulator Berjalan",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["health"]
        },
        "description": "Cek apakah semua service (termasuk IoT simulator) sehat dan responsive"
      }
    },
    {
      "name": "1.2 - Simulate IoT Sensor Data (POST to IoT endpoint)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var iotToken = pm.environment.get('iot_token');",
              "if (!iotToken) {",
              "  console.log('❌ IoT token tidak ditemukan!');",
              "  console.log('⚠️ Jalankan step 1.0 (Get IoT Token) terlebih dahulu!');",
              "  throw new Error('Missing IoT token - Run step 1.0 first');",
              "} else {",
              "  console.log('✓ IoT token tersedia, siap mengirim sensor data');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  console.log('✓ Sensor data berhasil dikirim ke Gateway');",
              "  var jsonData = pm.response.json();",
              "  console.log('Response:', JSON.stringify(jsonData, null, 2));",
              "  pm.environment.set('last_sensor_reading_id', jsonData.id || 'unknown');",
              "} else if (pm.response.code === 401) {",
              "  console.log('❌ Unauthorized - IoT token invalid atau expired. Jalankan step 1.0 lagi.');",
              "} else {",
              "  console.log('❌ Error sending sensor data. Status:', pm.response.code);",
              "  console.log('Response:', pm.response.text());",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{iot_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"zone_id\": 1,\n  \"moisture\": 42.5,\n  \"temperature\": 28.1,\n  \"ph\": 6.8,\n  \"nitrogen\": 75,\n  \"phosphorus\": 35,\n  \"potassium\": 55,\n  \"air_temp\": 28.1,\n  \"air_humidity\": 68.0,\n  \"light_lux\": 5000.0\n}"
        },
        "url": {
          "raw": "http://localhost:3000/iot/sensor",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["iot", "sensor"]
        },
        "description": "Kirim data sensor IoT melalui Gateway menggunakan IoT device token. Tidak ada login petani yang diperlukan. Data akan tersimpan di database dan di-publish ke RabbitMQ."
      }
    },
    {
      "name": "1.3 - Verifikasi Data Tersimpan di Database",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var iotToken = pm.environment.get('iot_token');",
              "if (!iotToken) {",
              "  console.log('❌ IoT token tidak ditemukan!');",
              "  throw new Error('Missing IoT token - Run step 1.0 first');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  console.log('✓ Data sensor terbaru berhasil diambil dari database');",
              "  var jsonData = pm.response.json();",
              "  console.log('Status:', jsonData.status);",
              "  if (jsonData.data) {",
              "    console.log('\\n📊 Latest readings:');",
              "    if (Array.isArray(jsonData.data)) {",
              "      console.log('Total readings:', jsonData.data.length);",
              "      if (jsonData.data.length > 0) {",
              "        var latest = jsonData.data[0];",
              "        console.log('  Zone ID:', latest.zone_id);",
              "        console.log('  Moisture:', latest.moisture + '%');",
              "        console.log('  Temperature:', latest.temperature + '°C');",
              "        console.log('  Recorded at:', latest.recorded_at);",
              "      }",
              "    } else {",
              "      console.log('  Zone ID:', jsonData.data.zone_id);",
              "      console.log('  Moisture:', jsonData.data.moisture + '%');",
              "      console.log('  Temperature:', jsonData.data.temperature + '°C');",
              "      console.log('  Recorded at:', jsonData.data.recorded_at);",
              "    }",
              "  }",
              "} else if (pm.response.code === 401) {",
              "  console.log('❌ Unauthorized - Jalankan step 1.0 untuk mendapatkan token.');",
              "} else {",
              "  console.log('❌ Error:', pm.response.code);",
              "  console.log('Response:', pm.response.text());",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{iot_token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/api/sensors/current",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "sensors", "current"]
        },
        "description": "Verifikasi data sensor terbaru yang telah tersimpan di database menggunakan IoT token - Endpoint: /api/sensors/current"
      }
    },
    {
      "name": "1.4 - Cek Health Mosquitto MQTT",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["health"]
        },
        "description": "Verifikasi Mosquitto MQTT Broker sehat dan terhubung"
      }
    },
    {
      "name": "1.5 - Cek RabbitMQ Queue",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:15672",
          "protocol": "http",
          "host": ["localhost"],
          "port": "15672"
        },
        "description": "Buka RabbitMQ Management UI (http://localhost:15672), login: guest/guest, verifikasi queue 'sensor.data' dan periksa messages yang masuk"
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "oauth_url",
      "value": "http://localhost:3002"
    },
    {
      "key": "iot_token",
      "value": ""
    }
  ]
}
